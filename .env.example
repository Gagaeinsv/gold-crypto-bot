# ─────────────────────────────────────────────────────────────────────────────
#  Gaming News Telegram Bot — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
GAMING_BOT_TOKEN=your_bot_token_here

# Telegram Channel ID — use @channel_username or numeric -100XXXXXXXXXX
GAMING_CHANNEL_ID=@your_gaming_channel

# Your Telegram user ID (for admin notifications, optional)
ADMIN_ID=123456789

# RAWG API Key — FREE at https://rawg.io/apidocs (used for release dates)
# Leave empty to disable upcoming releases feature
RAWG_API_KEY=your_rawg_api_key_here

# NewsAPI Key — FREE tier at https://newsapi.org/ (optional, RSS is used by default)
NEWS_API_KEY=
