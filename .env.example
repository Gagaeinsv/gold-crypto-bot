# ─────────────────────────────────────────────────────────────────────────────
#  Gaming News Telegram Bot — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
GAMING_BOT_TOKEN=your_bot_token_here

# Telegram Channel ID — use @channel_username or numeric -100XXXXXXXXXX
GAMING_CHANNEL_ID=@your_gaming_channel

# Your Telegram user ID (for admin notifications, optional)
ADMIN_ID=123456789

# RAWG API Key — FREE at https://rawg.io/apidocs (used for release dates)
# Leave empty to disable upcoming releases feature
RAWG_API_KEY=your_rawg_api_key_here

# Gemini API Key — FREE at https://aistudio.google.com/
# Used to translate and rewrite all posts into engaging Ukrainian text.
# Without this key the bot still works but posts will be in English.
GEMINI_KEY=your_gemini_api_key_here

# NewsAPI Key — FREE tier at https://newsapi.org/ (optional, RSS is used by default)
NEWS_API_KEY=

# ─── Розклад v2.0.2 (ігровий бот) ───────────────────────────────────────────
CHECK_INTERVAL_MIN=60
NEWS_MIN_POST_GAP_HOURS=4
MAX_POSTS_PER_DAY=5
MIN_POSTS_PER_DAY=1
FORCE_POST_AFTER_HOURS=20
RSS_MAX_AGE_HOURS=48
RSS_MAX_AGE_FORCE_HOURS=168
GIVEAWAY_IF_NO_NEWS_HOURS=24
