# Скопіюй на сервер:  cp .env.example .env   потім заповни значення та chmod 600 .env
# Реальні секрети не комітяться (.env у .gitignore).

# ─── Telegram (обовʼязково) ─────────────────────────────────────
TOKEN=
ADMIN_ID=
# Юзернейм бота з @ — у постах каналу буде клікабельне посилання https://t.me/… (не залишай placeholder @your_bot).
BOT_USERNAME=
CHANNEL_ID=

# ─── Groq (основний AI) ──────────────────────────────────────────
# Ключ: https://console.groq.com/keys
GROQ_KEY=
# Канал і статті — висока квота; сигнали юзерам — «важча» модель
GROQ_MODEL_NEWS=llama-3.1-8b-instant
GROQ_MODEL_SIGNALS=llama-3.3-70b-versatile
# GROQ_MODEL=   # застаріле; якщо задано — підміняє лише SIGNALS

# ─── OpenRouter (рекомендовано: коли Groq повертає 429) ───────────
# Ключі: https://openrouter.ai/keys — можна два акаунти: round-robin + автоперемикання при 429
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
# Додаткові ключі через кому (рідко потрібно, якщо вже є два основні)
# OPENROUTER_API_KEYS=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Якщо порожньо — для vision використовується OPENROUTER_MODEL
OPENROUTER_VISION_MODEL=
# Опційно, для статистики OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Gold Crypto Trading Bot

# ─── Google Gemini (після OpenRouter у ланцюжку fallback; також deep/chart) ───
# Ключ: https://aistudio.google.com/apikey
GEMINI_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Опційно: лише для /deepanalysis (довгий текст). Якщо звіт обривається — спробуй gemini-2.5-flash-lite
#GEMINI_DEEP_ANALYSIS_MODEL=gemini-2.5-flash-lite
DEEP_ANALYSIS_PROVIDER=gemini
CHART_VISION_PROVIDER=gemini

# ─── Новини / золото (опційно) ───────────────────────────────────
NEWS_API=
GOLD_API_KEY=

# ─── NOWPayments + вебхук (опційно) ───────────────────────────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Криптовалюта для оплати (як у дашборді NOWPayments, наприклад usdttrc20, btc, eth)
NOWPAYMENTS_PAY_CURRENCY=usdttrc20
# Публічна адреса бота для IPN: бажано https://your-domain (http часто дає 400 від NOWPayments).
PUBLIC_BASE_URL=
# Якщо /min-amount не відповість — запасний мінімум у монетах `pay_currency`.
NOWPAYMENTS_MIN_PAY_CRYPTO_FALLBACK=6
# Мультиплікатор до ефективного мінімуму (`/min-amount`, fallback або HARD_FLOOR).
NOWPAYMENTS_MIN_PAY_MARGIN=1.035
# Додається до `min_eff * margin` у **ті ж одиниці, що й pay_currency**.
NOWP_MIN_PAY_CRYPTO_ABS_PAD=0.2
# Примусовий нижній поріг у pay_currency, якщо акаунт NOWPayments вищий за відповідь API.
NOWP_MIN_PAY_CRYPTO_HARD_FLOOR=
# Після estimate — невеликий запас у USD (не перегинати; головний стопор — CAP нижче).
NOWP_ESTIMATE_CUSHION_USD=0.55
# Верхня межа інвойса над ціною в меню: list + max(ABS, list*pct%). Для низьких тарифів важливий ABS—NOWPayments часто вимагає >$18 при list $12.5.
NOWP_CRYPTO_MAX_SURCHARGE_ABS_USD=14
NOWP_CRYPTO_MAX_SURCHARGE_PCT=35
# Небезпечно: зняти обмеження націнування (лише якщо розумієш ризики).
# NOWP_CRYPTO_DISABLE_INVOICE_CAP=1
NOWPAYMENTS_MIN_TOPUP_STEP_USD=0.1
NOWPAYMENTS_MIN_TOPUP_CEILING_USD=120
NOWPAYMENTS_MIN_TOPUP_MAX_STEPS=400
# Ретраї POST /payment після AMOUNTMINIMALERROR (в межах CAP).
NOWP_AMOUNT_MINIMAL_ERR_PAD_USD=0.35
NOWP_AMOUNT_MINIMAL_ERR_PAD_RAMP_USD=0.05
NOWP_AMOUNT_MINIMAL_ERR_MAX_RETRIES=20
NOWP_PAYMENTS_FIXED_RATE=1

# ─── Монітор і вебхук TradingView (опційно) ─────────────────────
MONITOR_INTERVAL_SEC=60
TV_WEBHOOK_SECRET=
TV_WEBHOOK_PORT=8080
