# ─────────────────────────────────────────────────────────────────────────────
#  Gaming News Telegram Bot v1.4.0
#  Скопіюй у .env і заповни обов'язкові поля
# ─────────────────────────────────────────────────────────────────────────────

# === ОБОВ'ЯЗКОВО ===
GAMING_BOT_TOKEN=your_bot_token_here
GAMING_CHANNEL_ID=@your_gaming_channel

# === РЕКОМЕНДОВАНО (українські пости через AI) ===
GEMINI_KEY=your_gemini_api_key_here

# === ОПЦІЙНО ===
ADMIN_ID=123456789
RAWG_API_KEY=your_rawg_api_key_here
NEWS_API_KEY=

# ─── Ліміти публікацій (можна не чіпати) ─────────────────────────────────────
# Як часто перевіряти новини (хвилини)
CHECK_INTERVAL_MIN=20

# Мінімум годин між будь-якими двома постами
MIN_POST_GAP_HOURS=6

# Максимум постів на добу (новини + роздачі + релізи)
MAX_POSTS_PER_DAY=4

# Скільки постів за одну перевірку (зазвичай 1)
MAX_POSTS_PER_CYCLE=1

# Безкоштовні ігри: макс. на добу / на тиждень
MAX_GIVEAWAYS_PER_DAY=1
MAX_GIVEAWAYS_PER_WEEK=3

# Мінімум годин між постами про роздачі
MIN_HOURS_BETWEEN_GIVEAWAYS=36

# Скільки новинних постів після останньої роздачі, перш ніж знову дати гру
NEWS_BEFORE_GIVEAWAY=3

# Якщо стільки годин нічого не виходило — примусово один пост (мін. 2 рази/тиждень)
FALLBACK_HOURS=84
