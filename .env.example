# ─────────────────────────────────────────────────────────────────────────────
#  Gaming News Telegram Bot v2.0.0
#  Фокус: PlayStation, PS Plus, Xbox / Game Pass
# ─────────────────────────────────────────────────────────────────────────────

# === ОБОВ'ЯЗКОВО ===
GAMING_BOT_TOKEN=your_bot_token_here
GAMING_CHANNEL_ID=@your_gaming_channel

# === РЕКОМЕНДОВАНО (пости UA + RU через Gemini) ===
GEMINI_KEY=your_gemini_api_key_here

# === ОПЦІЙНО ===
ADMIN_ID=123456789
RAWG_API_KEY=your_rawg_api_key_here

# ─── Розклад (за замовчуванням — кілька постів на день, без спаму) ───────────
# Перевірка джерел (хвилини)
CHECK_INTERVAL_MIN=60

# Мінімум годин між постами про новини
NEWS_MIN_POST_GAP_HOURS=4

# Максимум постів на добу
MAX_POSTS_PER_DAY=5

# Роздача лише якщо стільки годин не було новин PS/Xbox
GIVEAWAY_IF_NO_NEWS_HOURS=24

# Роздачі: макс. на добу / тиждень
MAX_GIVEAWAYS_PER_DAY=1
MAX_GIVEAWAYS_PER_WEEK=2
MIN_HOURS_BETWEEN_GIVEAWAYS=48

# Примусовий пост якщо довго тиша (години)
FALLBACK_HOURS=72
